############################ Sub-Section B #####################################
################################################################################
## Question 3: Regress ln_selfinc on ln_selflab, ln_live_bg, ln_edu, and ln_land_cult
# OLS
ols5 <- lm_robust(ln_selfinc ~ ln_selflab + ln_live_bg + ln_edu +ln_land_cult, Nepal)
summary(ols5)
## Question 4: IV estimation of ln_selfinc on ln_selflab instrumented by (ln_selflab_stock) and controls
# part a) IV regression
iv1 <- iv_robust(ln_selfinc ~  ln_selflab + ln_live_bg + ln_edu +ln_land_cult
| ln_selflab_stock+ ln_live_bg + ln_edu +ln_land_cult  ,
data = Nepal, diagnostics = TRUE)
summary(iv1)
# part b) 2SLS, stages one and two
# First stage
fs <- lm_robust(ln_selflab ~ ln_selflab_stock + ln_live_bg + ln_edu +ln_land_cult, Nepal)
summary(fs)
Nepal$ln_selflab_star <- fs$fitted.values
# Second stage
ss <- lm_robust(ln_selfinc ~ ln_selflab_star + ln_live_bg + ln_edu +ln_land_cult, Nepal)
summary(ss)
# part c) Reduced form
rf <- lm_robust(ln_selfinc ~ ln_selflab_stock + ln_live_bg + ln_edu +ln_land_cult, Nepal)
summary(rf)
