# Clear the environment
rm(list = ls())
setwd("~/Documents/R_AST/Econometrics")
setwd("~/Documents/R_AST/Econometrics/Practical 2")
# Load the dataset
anes = read.csv("anes08.csv")
# View the dataset to ensure it loaded correctly
View(anes)
library(dplyr)
# Running the OLS regression using the lm() function
model1 <- lm(thermimmigrant ~ gender, data = anes)
# Summary of the model
summary(model1)
# a. Running the regression of thermimmigrant on both gender and gun ownership (1 and 5)
model2 <- lm(thermimmigrant ~ gender + gunown, data = anes)
# Summary of the new model
summary(model2)
# Checking the current coding of gunown using the table() function to view its frequency distribution
table(anes$gunown)
# C. Re-code the gunown variable so that 1 means owns a gun, and 0 means does not own a gun.
anes$gunown <- recode(anes$gunown, `5` = 0, `1` = 1)
# Confirm the recoding by viewing the updated frequency distribution
table(anes$gunown)
# d. Run the model again with the recoded gun ownership (1 = owns gun and 0 = does not own guns)
model3 <- lm(thermimmigrant ~ gender + gunown, data = anes)
# Summary of the updated model
summary(model3)
# add socio-economic co-variates (children, income) to the OLS regression
model4 <- lm(thermimmigrant ~ gender + gunown + children + income, data = anes)
# Summary of the full model
summary(model4)
