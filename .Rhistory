## Question 2: Regress natural log of price (ln_price) on natural log of lotsize (ln_lotsize), number of bedrooms (bdrms), and/or colonial dummy
# part a)
ols2 = lm_robust(ln_price ~ ln_lotsize + bdrms, data = hprice)
summary(ols2)
# Predicted house price for a house with a 1700-sqaure-feet lot size and 3 bedrooms.
lhp = summary(ols2)$coefficients[1,1]+summary(ols2)$coefficients[2,1]*log(1700)+summary(ols2)$coefficients[3,1]*3
hp = exp(lhp)
hp
# part b) Dummy variables and Interaction term:
ols3 = lm_robust(price ~ bdrms*colonial, data = hprice)
summary(ols3)
# part c) Quadratic term:
ols4 = lm_robust(price~bdrms+I(bdrms^2),data = hprice)
summary(ols4)
# Predicted house price for a houses with 3 bedrooms.
a=summary(ols4)$coefficients[1,1] + summary(ols4)$coefficients[2,1] *3 +summary(ols4)$coefficients[3,1]*3^2
a
